{
  "name": "gym-management-system",
  "private": true,
  "version": "0.2.0",
  "description": "Desktop-first gym management system (Electron + SQLite + Next.js UI)",
  "author": "Gym Management Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:desktop": "npm run dev",
    "dev:cloud": "npm --prefix cloud-backend run dev",
    "dev:remote": "npm --prefix remote-pwa run dev",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:dev:cloud\" \"npm:dev:remote\"",
    "dev:web": "next dev -p 3000",
    "dev:electron": "wait-on tcp:3000 && electronmon electron/main.cjs",
    "build:web": "next build",
    "build": "npm run build:web",
    "rebuild:native": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:win:signed": "npm run build && electron-builder --win nsis --publish never",
    "dist:win:portable": "npm run build && electron-builder --win portable --publish never",
    "dist:win:dir": "npm run build && electron-builder --win dir --publish never",
    "test": "npm run test:desktop-core && npm run test:cloud",
    "test:desktop-core": "node --test electron/modules/sync/__tests__/circuitBreaker.test.cjs",
    "test:cloud": "npm --prefix cloud-backend test",
    "start:web": "next start -p 3000",
    "start": "electron .",
    "lint": "next lint"
  },
  "build": {
    "appId": "com.gym.management.desktop",
    "productName": "Gym Management Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "!electron/**/__tests__/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "next": "^15.3.5",
    "node-cron": "^4.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "typescript": "~5.9.3",
    "wait-on": "^9.0.4"
  }
}
